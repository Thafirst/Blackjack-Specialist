<Window x:Class="Blackjack.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Blackjack.Wpf"
        mc:Ignorable="d"
        Title="Blackjack Specialist"
        Height="700"
        Width="900">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ==================== -->
        <!-- Dealer Area           -->
        <!-- ==================== -->

        <TextBlock Grid.Row="0"
                   Text="Dealer"
                   FontSize="28"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Dealer Cards -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <!-- First Dealer Card -->
                <Border BorderBrush="Black"
                        BorderThickness="1"
                        Width="80"
                        Height="120"
                        Margin="5">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="{Binding DealerCards[0].Rank}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding DealerCards[0].Suit}"
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>
                </Border>


                <!-- Second Dealer Card -->
                <Border BorderBrush="Black"
                        BorderThickness="1"
                        Width="80"
                        Height="120"
                        Margin="5">

                    <Grid>

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="{Binding DealerCards[1].Rank}"
                                       FontSize="20"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding DealerCards[1].Suit}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>


                        <!-- Hidden Dealer Card Overlay -->
                        <Border Background="Gray">

                            <Border.Style>
                                <Style TargetType="Border">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding HideDealerSecondCard}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>

                        </Border>

                    </Grid>
                </Border>


                <!-- Additional Dealer Cards -->
                <ItemsControl ItemsSource="{Binding AdditionalDealerCards}"
                              VerticalAlignment="Center">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>

                            <StackPanel Orientation="Horizontal"/>

                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border BorderBrush="Black"
                                    BorderThickness="1"
                                    Width="80"
                                    Height="120"
                                    Margin="5">

                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center">

                                    <TextBlock Text="{Binding Rank}"
                                               FontSize="20"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Suit}"
                                               FontSize="16"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>


            <!-- Dealer Hand Value -->
            <TextBlock Text="{Binding DealerHandValue}"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0">

                <TextBlock.Style>

                    <Style TargetType="TextBlock">

                        <Setter Property="Visibility"
                                Value="Visible"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding CanStartGame}"
                                         Value="False">

                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </TextBlock.Style>

            </TextBlock>

        </StackPanel>


        <!-- ==================== -->
        <!-- Game Status           -->
        <!-- ==================== -->

        <TextBlock Grid.Row="2"
                   Text="{Binding GameStatus}"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>


        <!-- ==================== -->
        <!-- Player Area           -->
        <!-- ==================== -->

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Player"
                       FontSize="28"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>


            <!-- Player Cards -->
            <ItemsControl ItemsSource="{Binding PlayerCards}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>

                        <StackPanel Orientation="Horizontal"/>

                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>


                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border BorderBrush="Black"
                                BorderThickness="1"
                                Width="80"
                                Height="120"
                                Margin="5">

                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center">

                                <TextBlock Text="{Binding Rank}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Suit}"
                                           FontSize="16"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>


            <!-- Player Hand Value -->
            <TextBlock Text="{Binding PlayerHandValue}"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>

        </StackPanel>


        <!-- ==================== -->
        <!-- Buttons               -->
        <!-- ==================== -->

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,10">

            <Button Content="StartGame"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Click="StartGame_Pressed"
                    IsEnabled="{Binding CanStartGame}"/>

            <Button Content="Hit"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Click="Hit_Pressed"
                    IsEnabled="{Binding IsPlayerTurn}"/>

            <Button Content="Stand"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Click="Stand_Pressed"
                    IsEnabled="{Binding IsPlayerTurn}"/>

        </StackPanel>


    </Grid>
</Window>